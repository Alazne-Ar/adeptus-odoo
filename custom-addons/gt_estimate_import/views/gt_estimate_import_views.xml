<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gt_estimate_import_form" model="ir.ui.view">
        <field name="name">gt.estimate.import.form</field>
        <field name="model">gt.estimate.import</field>
        <field name="arch" type="xml">
            <form string="Peritaje GT Estimate">
                <header>
                    <button name="action_extract" type="object" string="Extraer piezas"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_extract" type="object" string="Volver a extraer"
                            invisible="state != 'extracted'"
                            confirm="Se borrarán las líneas actuales y sus cambios. ¿Continuar?"/>
                    <button name="action_create_purchase" type="object" string="Crear pedido de compra"
                            class="btn-primary" invisible="state != 'extracted'"/>
                    <button name="action_reset" type="object" string="Volver a borrador"
                            invisible="state != 'extracted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase" type="object" class="oe_stat_button"
                                icon="fa-shopping-cart" invisible="not purchase_id">
                            <span class="o_stat_text">Pedido de compra</span>
                        </button>
                        <field name="purchase_id" invisible="1"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="pdf_file" filename="pdf_filename"
                                   readonly="state == 'done'"/>
                            <field name="pdf_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="partner_id" readonly="state == 'done'"
                                   context="{'res_partner_search_mode': 'supplier'}"/>
                            <field name="order_total" invisible="state == 'draft'"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="not notes">
                        <field name="notes" nolabel="1"/>
                    </div>
                    <notebook>
                        <page string="Piezas" name="lines">
                            <field name="line_ids" readonly="state == 'done'">
                                <list editable="bottom"
                                      decoration-warning="source == 'ocr'"
                                      decoration-muted="not to_order">
                                    <field name="sequence" widget="handle"/>
                                    <field name="to_order" widget="boolean_toggle"/>
                                    <field name="line_type"/>
                                    <field name="code"/>
                                    <field name="description"/>
                                    <field name="source" widget="badge"
                                           decoration-warning="source == 'ocr'"
                                           decoration-success="source == 'text'"/>
                                    <field name="qty"/>
                                    <field name="price"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="raw_code" optional="hide"/>
                                    <field name="page" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="PDF" name="pdf" invisible="not pdf_file">
                            <field name="pdf_file" widget="pdf_viewer" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gt_estimate_import_list" model="ir.ui.view">
        <field name="name">gt.estimate.import.list</field>
        <field name="model">gt.estimate.import</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Fecha"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="purchase_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'extracted'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="gt_estimate_import_action" model="ir.actions.act_window">
        <field name="name">Peritajes GT Estimate</field>
        <field name="res_model">gt.estimate.import</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sube tu primer peritaje</p>
            <p>Crea un registro, adjunta el PDF de GT Estimate y pulsa «Extraer piezas».</p>
        </field>
    </record>

    <menuitem id="gt_estimate_import_menu" name="Peritajes GT Estimate"
              parent="purchase.menu_procurement_management"
              action="gt_estimate_import_action" sequence="50"/>
</odoo>
