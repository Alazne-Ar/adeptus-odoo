<odoo>
    <record id="adeptus_table_list_views" model="ir.ui.view">
        <field name="name">adeptus_calvastres.table.list</field>
        <field name="model">adeptus_calvastres.table</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="empty_table" widget="boolean"/>
                <field name="bookings"/>
                <!--
                <field name="pos_X"/>
                <field name="pos_Y"/>
                -->
            </list>
        </field>
    </record>

