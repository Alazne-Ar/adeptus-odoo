<odoo>
    <record id="adeptus_table_list_views" model="ir.ui.view">
        <field name="name">adeptus_calvastres.table.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="adeptus_table_form" model="ir.ui.view">
        <field name="name">adeptus_calvastres.table.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_adeptus_table" model="ir.actions.act_window">
        <field name="name">Tables</field>
        <field name="res_model">adeptus_calvastres.table</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>