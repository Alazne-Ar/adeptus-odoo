<odoo>
    <record id="view_partner_list" model="ir.ui.view">
        <field name="name">adeptus_calvastres.partner.list</field>
        <field name="model">adeptus_calvastres.partner</field>
        <field name="inherit_id" eval="False"/>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_generate_monthly_receipt"
                            type="object"
                            string="Generar recibos del socio"
                            class="btn-primary">
                    </button>
                </header>
                <field name="name"/>
                <field name="surname"/>
                <field name="email"/>
                <field name="mobile"/>
                <field name="member_date"/>
                <field name="is_member"/>
                <field name="bookings"/>
            </list>
        </field>
    </record>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">adeptus_calvastres.partner.form</field>
        <field name="model">adeptus_calvastres.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="surname"/>
                        <field name="email"/>
                        <field name="mobile"/>
                        <field name="member_date"/>
                        <field name="is_member"/>
                        <field name="bookings"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_adeptus_partner" model="ir.actions.act_window">
        <field name="name">Partners</field>
        <field name="res_model">adeptus_calvastres.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_member','=',True)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0,0, {'view_mode': 'list', 'view_id':ref('view_partner_list')})]"/>
    </record>
</odoo>